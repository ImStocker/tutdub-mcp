# TutDub CLI / MCP configuration - copy to `.env` in the directory you run
# `tutdub-mcp` from (or point TUTDUB_ENV_FILE at it). Variables already set
# in the environment are never overridden; precedence is:
# flags > environment > .env > config file > defaults.

# API base URL (the /v1 suffix is required: production nginx strips /api and
# Nest serves versioned routes under its global v1 prefix; for a local dev
# server use e.g. http://localhost:5453/v1)
TUTDUB_SERVER_URL=https://tutdub.com/api/v1

# Frontend base URL, used by `login` (e.g. http://localhost:5173/app)
TUTDUB_FRONTEND_URL=https://tutdub.com/app

# Bearer token; overrides the token stored by `tutdub-mcp login` (useful in CI)
# TUTDUB_TOKEN=td_cli_...

# Config directory (default: %APPDATA%\tutdub-mcp, ~/.config/tutdub-mcp, ...)
# TUTDUB_CONFIG_HOME=/path/to/config

# Explicit env file to load instead of ./.env - handy for MCP hosts that
# launch the server with an unrelated working directory.
# TUTDUB_ENV_FILE=/path/to/tutdub.env
